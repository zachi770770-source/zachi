# Backend: "graph" or "smtp"
BACKEND=smtp

# ── SMTP backend (Outlook.com / Hotmail) ──────────────────────────────────────
SMTP_USER=your_email@outlook.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587

# ── Microsoft Graph API backend (Office 365 / Azure AD) ──────────────────────
# Create an App Registration in Azure Portal → API permissions → Mail.Send
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
SENDER_EMAIL=your_email@yourdomain.com
