# Environment variables for "מדייטים לאהבה".
# Names only — never commit real values/secrets. Copy to .env.local for local
# development, and set the real values in the Vercel project settings.

# ── Site ──────────────────────────────────────────────────────────────
# Optional canonical base-URL override. In production it falls back to
# https://www.zachi.co.il automatically, so this is usually left empty.
NEXT_PUBLIC_SITE_URL=

# ── Waitlist persistence (Postgres / Supabase) ────────────────────────
# REQUIRED in Vercel Preview AND Production. Run the migration under
# src/lib/waitlist/migrations before connecting. Without it the waitlist
# endpoint returns 503 (it never silently falls back to memory on Vercel).
DATABASE_URL=
# Local development/test ONLY. Ignored on Vercel Preview/Production.
WAITLIST_ALLOW_MEMORY=

# ── Contact form email delivery (Resend) ──────────────────────────────
# All three REQUIRED for the contact form to deliver. Missing any → the
# form returns a clear error (never a false success).
RESEND_API_KEY=
# Verified sender in Resend, e.g. "מדייטים לאהבה <noreply@your-domain>"
CONTACT_FROM_EMAIL=
# Destination inbox that receives contact submissions.
CONTACT_TO_EMAIL=

# ── „שאלו את הספר” assistant (optional) ───────────────────────────────
ANTHROPIC_API_KEY=
COMPASS_ASSISTANT_ENABLED=
COMPASS_MODEL=
COMPASS_REQUIRED_BOOK_VERSION=
# Retrieval relevance floor (0..1). Default 0.30, calibrated on holdout75 after
# the Hebrew normalization/expansion upgrade (recall@5 61%→76%). Optional override.
COMPASS_MIN_SCORE=
COMPASS_PG_URL=

# ── Payments (only when opening sales) ────────────────────────────────
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# ── Analytics (optional, public) ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Note: VERCEL_ENV is injected automatically by Vercel — do not set it here.
