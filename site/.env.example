# ─────────────────────────────────────────────────────────────────────────────
# .env.example — שמות משתני סביבה בלבד. אין להזין כאן ערכים אמיתיים לעולם.
# הערכים האמיתיים מוגדרים ב-Vercel (Production/Preview) ואינם נשמרים ב-Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── מכירות (Sales) ───────────────────────────────────────────────────────────
# חייב להישאר "false". כל עוד false: אין checkout, אין תשלום, אין כפתור הורדה.
# יש להפוך ל-true אך ורק כאשר כל שרשרת ה-fulfillment האמיתית מחוברת ונבדקה.
SALES_ENABLED=

# ── רשימת המתנה (Waitlist) ───────────────────────────────────────────────────
# מחרוזת חיבור ל-Postgres של Supabase. שרת בלבד. עד שתוגדר - ה-waitlist מחזיר 503.
DATABASE_URL=
# עוקף לזיכרון לבדיקות בלבד. לעולם לא "true" בפרודקשן.
WAITLIST_ALLOW_MEMORY=

# ── אחסון הספר הדיגיטלי (Supabase Storage — שרת בלבד) ────────────────────────
# כתובת פרויקט Supabase. שרת בלבד. לעולם לא כ-NEXT_PUBLIC_.
SUPABASE_URL=
# מפתח סודי שרתי (service role). שרת בלבד. לעולם, בשום מצב, לא כ-NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# שם ה-bucket הפרטי שבו נמצא קובץ הספר. ה-bucket חייב להישאר פרטי.
BOOK_STORAGE_BUCKET=
# נתיב האובייקט (ה-PDF) בתוך ה-bucket. אינו נחשף לדפדפן - רק קישור חתום זמני.
BOOK_PDF_PATH=
# תוקף הקישור החתום בשניות. טווח מותר 60–900. חסר → ברירת מחדל בטוחה 900.
BOOK_DOWNLOAD_TTL_SECONDS=

# ── אנליטיקה (אופציונלי, כבוי כברירת מחדל) ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── ספק תשלום (עתידי) ────────────────────────────────────────────────────────
PAYMENT_PROVIDER=
