# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the import env TEMPLATE (names only, no values) is committed on purpose.
!.env.import.example

# ── Section 6: local book import — never commit the book, artifacts, or secrets ──
# כל הורדת ה-PDF, הטקסט המחולץ וקבצי ה-chunks נכתבים כאן ומוחרגים לגמרי.
.import-tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
