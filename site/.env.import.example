# ── סעיף 6: ייבוא ספר 888 — משתני סביבה להרצה מקומית בלבד ────────────────
# העתיקו קובץ זה ל-.env.import (מוחרג מ-Git) ומלאו ערכים אמיתיים.
# אין להדביק ערכים בקובץ הזה, ואין לבצע commit ל-.env.import.
# מפתח השרת מיועד אך ורק לסביבת הייבוא המקומית — לעולם לא ב-Vercel.

# כתובת פרויקט Supabase, למשל https://<project-ref>.supabase.co
SUPABASE_URL=

# מפתח שרת של Supabase. עדיפות ל-SUPABASE_SECRET_KEY; אם אינו קיים,
# השתמשו ב-SUPABASE_SERVICE_ROLE_KEY (ה-preflight בודק קודם SECRET ואז ROLE).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# חיבור Postgres: Session Pooler בפורט 5432 עם sslmode=require.
# דוגמה (ללא ערך אמיתי):
# postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
