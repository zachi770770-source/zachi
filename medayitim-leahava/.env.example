# Supabase — נמצא בלוח הבקרה של הפרויקט: Project Settings → API
# כתובת ה-URL של פרויקט ה-Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# מפתח ה-anon הציבורי (בטוח לשימוש בצד הלקוח, מוגן ע"י RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# מפתח ה-service role — צד שרת בלבד! משמש למחיקת משתמש מ-Supabase Auth.
# ⚠️ אסור בתכלית האיסור לחשוף אותו בצד הלקוח. אין לו קידומת NEXT_PUBLIC.
# אם לא מוגדר — מחיקת חשבון תמחק את כל נתוני המשתמש, אך לא את רשומת ה-Auth.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
